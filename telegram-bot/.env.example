# Careers@GFTV Telegram bot.
#
# Copy this file to .env on the VPS. .env is gitignored and must never be
# committed. This file is committed and must never hold a real value.
#
# The bot ships in phase 11, and reads every one of these from part 1 onwards.
# All six below are required and the bot refuses to start without them, naming
# every one that is missing rather than stopping at the first. That is
# deliberate even for the values a given part does not use yet: this is one
# process deployed all at once, and a skeleton that started happily without a
# service key would move the failure into the middle of somebody's linking
# attempt.

# BotFather token for careersgftv_bot.
# Telegram, message BotFather, /mybots, select the bot, API Token.
TELEGRAM_BOT_TOKEN=

# Telegram API credentials for Telethon.
# https://my.telegram.org, API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Same Supabase project as the site. Same variable names, deliberately, so the
# two halves of the build cannot drift onto different databases.
# Supabase dashboard, Project Settings, Data API for the URL, API Keys for the
# service_role key. The key bypasses row level security, so treat it like a
# database password and keep it on the VPS only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Base URL used when building links back to the portal. No trailing slash.
SITE_URL=https://careers.globalfurry.tv

# Shown as a button on the start message.
# The one optional variable here. Left empty, the button is not drawn at all,
# which is the same rule the site follows for the official banner: a link must
# not ship before the thing it points at exists.
DONATION_URL=

# Optional. One of DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
# With no scripted checks for the bot, the log is the account of what happened,
# so DEBUG is the setting to reach for while walking the checklist rather than
# something to leave on.
LOG_LEVEL=
