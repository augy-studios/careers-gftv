# Bot local state. Supabase is the shared source of truth for accounts, links,
# tokens, invites, and the notification outbox. SQLite holds only scheduling,
# rate limits, dedupe, and the registry of active interaction buttons, and none
# of that belongs in version control.
*.session
*.session-journal
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# The single instance lock, taken at startup and released by the kernel when
# the process ends. It holds the running process id and nothing else.
*.lock

# The rotating log. It is the bot's only account of what it did, and it names
# real Telegram accounts, so it stays on the VPS.
logs/

.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
