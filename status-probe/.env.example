# Careers@GFTV status probe.
#
# Copy this file to .env beside probe.py on the VPS. .env is gitignored and
# must never be committed. This file is committed and must never hold a real
# value.
#
# Three variables, and they are the same three values the Telegram bot has in
# its own .env. Same names on purpose, so the two processes cannot drift onto
# different databases or different sites. Nothing about Telegram is read here.

# Same Supabase project as the site.
# Supabase dashboard, Project Settings, Data API for the URL, API Keys for the
# service_role key. The key bypasses row level security, so treat it like a
# database password and keep it on the VPS only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The portal the probe watches. No trailing slash. Production, and never a
# preview deployment: a preview is torn down when its branch is, and a probe
# pointed at one would record a 404 for ever afterwards.
SITE_URL=https://careers.globalfurry.tv

# Optional. INFO is right for the VPS; DEBUG names every request.
LOG_LEVEL=INFO
