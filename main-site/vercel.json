{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["sin1"],

  "redirects": [
    {
      "source": "/jobs",
      "destination": "/search",
      "permanent": true
    },
    {
      "$comment": "8a. The staff manual moved to the docs site and this route stays as a redirect, so anybody who bookmarked it and any link written into the dashboard before the move keeps working. Not permanent: the docs site is not built until phase 13, and a 301 would be cached by every browser that followed it before the destination existed.",
      "source": "/admin/docs",
      "destination": "https://docs.careers.globalfurry.tv/staff",
      "permanent": false
    },
    {
      "source": "/admin/docs/:path*",
      "destination": "https://docs.careers.globalfurry.tv/staff/:path*",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "https://policy.globalfurry.tv/legal/privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "https://policy.globalfurry.tv/legal/terms",
      "permanent": false
    }
  ],

  "rewrites": [
    {
      "source": "/search",
      "destination": "/search/index.html"
    },
    {
      "source": "/jobs/:id",
      "destination": "/api/job-page?id=:id"
    },
    {
      "source": "/api/public/jobs.json",
      "destination": "/api/public/jobs-feed"
    },
    {
      "source": "/account",
      "destination": "/account/index.html"
    },
    {
      "source": "/account/applications",
      "destination": "/account/applications/index.html"
    },
    {
      "source": "/account/saved",
      "destination": "/account/saved/index.html"
    },
    {
      "source": "/account/tasks",
      "destination": "/account/tasks/index.html"
    },
    {
      "source": "/account/settings",
      "destination": "/account/settings/index.html"
    },
    {
      "source": "/account/security",
      "destination": "/account/security/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login/index.html"
    },
    {
      "source": "/admin/security",
      "destination": "/admin/security/index.html"
    },
    {
      "$comment": "Phase 7 built /admin and five pages under it, so the catch-all below now only catches the sections that belong to phase 8. Vercel matches the filesystem before it consults rewrites, so every real page wins on its own; the rule is what keeps 0c's promise that a staff member clicking an unbuilt section gets the phase sentence rather than an empty screen.",
      "source": "/admin/:path*",
      "destination": "/placeholder"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/assets/build-status.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/auth/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
